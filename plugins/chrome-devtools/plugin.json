{
  "id": "chrome-devtools",
  "name": "Chrome DevTools 调试",
  "version": "0.5.0",
  "api_version": 1,
  "description": "持久 CDP 连接、表达式执行、事件游标和截图；支持本机 Chrome 或兼容 V8 调试端口。",
  "entry": "plugin.py",
  "actions": {
    "targets": {
      "description": "Discover debugger targets without connecting",
      "parameters": {
        "endpoint": "loopback http origin; default http://127.0.0.1:9222",
        "timeout": "0.1..120 seconds, default 10"
      }
    },
    "connect": {
      "description": "Connect a persistent debugger WebSocket",
      "parameters": {
        "url": "loopback ws/wss URL or devtools://...inspector.html?ws=...",
        "timeout": "0.1..120 seconds",
        "heartbeat": "boolean default false for native inspector compatibility"
      }
    },
    "command": {
      "description": "Send a CDP command; no automatic retry",
      "parameters": {
        "method": "Domain.command",
        "params": "optional object",
        "session_id": "optional flattened CDP session ID",
        "timeout": "default 10 seconds"
      }
    },
    "evaluate": {
      "description": "Execute JavaScript in the connected runtime; inspect exceptionDetails",
      "parameters": {
        "expression": "JavaScript source",
        "await_promise": "boolean default true",
        "return_by_value": "boolean default true",
        "context_id": "optional execution context integer",
        "session_id": "optional CDP session ID",
        "timeout": "default 10 seconds"
      }
    },
    "events": {
      "description": "Read buffered events by cursor",
      "parameters": {
        "after": "integer >=0 default0",
        "limit": "1..100 default50"
      }
    },
    "screenshot": {
      "description": "Capture a page PNG as Runtime artifact; Page domain required",
      "parameters": {
        "timeout": "default10",
        "session_id": "optional CDP session ID"
      }
    },
    "status": {
      "description": "Transport, responsiveness, observed pause state, timestamps, close reason, bounded command history and late responses",
      "parameters": {}
    },
    "disconnect": {
      "description": "Close this debugger connection",
      "parameters": {}
    },
    "prepare": {
      "description": "Bounded startup probe; stops at first failure, never automatically resumes breakpoints or retries",
      "parameters": {
        "release_wait": "boolean default false; true explicitly sends runIfWaitingForDebugger and may start application",
        "timeout": "total budget seconds, default 6",
        "session_id": "optional flattened CDP session ID"
      }
    },
    "scripts": {
      "description": "Search cached script URLs after prepare/Debugger.enable; no source execution",
      "parameters": {
        "query": "case-insensitive URL substring",
        "offset": "default 0",
        "limit": "1..200 default 50",
        "session_id": "optional CDP session"
      }
    },
    "source": {
      "description": "Read a bounded source excerpt",
      "parameters": {
        "script_id": "required",
        "start_line": "one-based, default 1",
        "line_count": "1..300 default 80",
        "timeout": "seconds",
        "session_id": "optional"
      }
    },
    "stack": {
      "description": "Read latest observed paused stack; null when running or unobserved",
      "parameters": {
        "session_id": "optional"
      }
    },
    "breakpoint_set": {
      "description": "Set an exact-URL breakpoint; may pause execution when reached",
      "parameters": {
        "url": "required exact script URL",
        "line": "required one-based",
        "column": "one-based default 1",
        "condition": "optional JavaScript expression",
        "timeout": "seconds",
        "session_id": "optional"
      }
    },
    "breakpoint_remove": {
      "description": "Remove an explicit breakpoint",
      "parameters": {
        "breakpoint_id": "required returned breakpointId",
        "timeout": "seconds",
        "session_id": "optional"
      }
    },
    "resume": {
      "description": "Explicitly resume a paused JavaScript target",
      "parameters": {
        "timeout": "seconds",
        "session_id": "optional"
      }
    },
    "source_search": {
      "description": "Literal search in loaded JavaScript source with total time budget",
      "parameters": {
        "query": "required literal text",
        "script_id": "optional single script",
        "url_query": "optional URL filter",
        "offset": "script offset default 0",
        "max_scripts": "1..100 default 20",
        "limit": "match limit 1..500 default 100",
        "case_sensitive": "boolean default false",
        "timeout": "seconds",
        "session_id": "optional CDP session"
      }
    },
    "variables": {
      "description": "Read own properties without invoking getters; expand nested objectId separately",
      "parameters": {
        "object_id": "required from stack scope/this/value",
        "offset": "default 0",
        "limit": "1..200 default 50",
        "timeout": "seconds",
        "session_id": "optional CDP session"
      }
    },
    "frame_evaluate": {
      "description": "Evaluate in a paused frame; throws on potential side effects by default",
      "parameters": {
        "call_frame_id": "required from stack",
        "expression": "required",
        "allow_side_effects": "boolean default false; explicitly true permits mutation",
        "timeout": "seconds",
        "session_id": "optional CDP session"
      }
    },
    "pause": {
      "description": "Request a JavaScript pause",
      "parameters": {
        "timeout": "seconds",
        "session_id": "optional CDP session"
      }
    },
    "step_over": {
      "description": "Step over while paused",
      "parameters": {
        "timeout": "seconds",
        "session_id": "optional CDP session"
      }
    },
    "step_into": {
      "description": "Step into while paused",
      "parameters": {
        "timeout": "seconds",
        "session_id": "optional CDP session"
      }
    },
    "step_out": {
      "description": "Step out while paused",
      "parameters": {
        "timeout": "seconds",
        "session_id": "optional CDP session"
      }
    },
    "pause_snapshot": {
      "description": "Read a compact paused stack, top-frame locals and source; never evaluates getters or resumes",
      "parameters": {
        "session_id": "optional CDP session",
        "timeout": "inspection total seconds default 3",
        "frame_limit": "1..20 default 5",
        "variable_limit": "0..50 default 12; top local scope only",
        "source_lines": "0..31 default 7"
      }
    },
    "wait_for_pause": {
      "description": "Wait on debugger events, no polling; returns paused/timeout/disconnected/state_changed. Timeout does not cancel or resume target.",
      "parameters": {
        "session_id": "optional CDP session",
        "timeout": "inspection total seconds default 3",
        "frame_limit": "1..20 default 5",
        "variable_limit": "0..50 default 12; top local scope only",
        "source_lines": "0..31 default 7",
        "wait_seconds": "0..20 default5; inspection has separate timeout",
        "after_pause": "return only a newer pause_id, default0 includes current pause",
        "summary": "boolean default true; include compact snapshot"
      }
    }
  }
}
